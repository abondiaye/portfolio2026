<!DOCTYPE html>
<html lang="{{ locale|default('fr') }}" translate="no">
<head>
    <meta charset="UTF-8">
    <meta name="google" content="notranslate">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ tr.htmlTitle }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ tr.metaDesc }}{% endblock %}">
    <meta name="author" content="N'DIAYE Abdoulaye">
    <meta name="theme-color" content="#08090A">
    <meta property="og:title" content="{{ tr.htmlTitle }}">
    <meta property="og:description" content="{{ tr.ogDesc }}">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="{{ tr.ogLocale }}">
    {% if urls is defined %}<link rel="alternate" hreflang="fr" href="{{ absolute_url(urls.fr) }}">
    <link rel="alternate" hreflang="en" href="{{ absolute_url(urls.en) }}">
    <link rel="alternate" hreflang="x-default" href="{{ absolute_url(urls.fr) }}">{% endif %}
    <meta property="og:image" content="{{ absolute_url(asset('asset/projets/portfolio.png')) }}">
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml" id="favicon">
    <link rel="alternate icon" href="{{ asset('favicon-32.png') }}" type="image/png">
    <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&family=Funnel+Sans:ital,wght@0,300..800;1,300..800&family=Geist+Mono:wght@300..600&display=swap">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% block body %}{% endblock %}
    {% block javascripts %}{% endblock %}
</body>
</html>
