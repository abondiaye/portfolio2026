<section class="sec paper is-night" id="parcours" aria-labelledby="parcours-titre">
    {# Décor : un cube qui gravit un escalier infini (vert fluo) ; il monte quand on descend la page, redescend quand on remonte #}
    <div class="pc-scene" aria-hidden="true">
        <div class="pc-stick">
            <svg class="pc-svg" viewBox="0 0 300 300" data-cube>
                <defs>
                    <clipPath id="pcClip"><rect width="300" height="300"/></clipPath>
                    <linearGradient id="pcShadow" x1="0" x2="0" y1="0" y2="1">
                        <stop offset="0%" stop-color="rgba(0,0,0,.55)"/><stop offset="100%" stop-color="rgba(0,0,0,0)"/>
                    </linearGradient>
                    <radialGradient id="pcFadeG" cx="50%" cy="50%" r="50%">
                        <stop offset="55%" stop-color="#fff"/><stop offset="100%" stop-color="#000"/>
                    </radialGradient>
                    <mask id="pcFade"><rect width="300" height="300" fill="url(#pcFadeG)"/></mask>
                    <filter id="pcBoxGlow" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="6"/></filter>
                </defs>
                <g clip-path="url(#pcClip)" mask="url(#pcFade)">
                    <g class="pc-stairs">
                        {% for i in 0..6 %}
                            <rect class="pc-tread" x="{{ i * 60 - 60 }}" y="{{ 300 - i * 60 }}" width="120" height="10"/>
                            <rect x="{{ i * 60 - 60 }}" y="{{ 310 - i * 60 }}" width="120" height="22" fill="url(#pcShadow)"/>
                        {% endfor %}
                        <g class="pc-box">
                            <rect class="pc-box-glow" x="75" y="150" width="30" height="30" filter="url(#pcBoxGlow)"/>
                            <rect class="pc-box-core" x="75" y="150" width="30" height="30" rx="2"/>
                        </g>
                    </g>
                </g>
            </svg>
        </div>
    </div>
    <div class="wrap">
        <p class="eyebrow reveal"><i></i>{{ tr.tlEyebrow }}</p>
        <h2 id="parcours-titre" class="sec-title" data-head>{{ tr.tlTitle|raw }}</h2>

        <ul class="stats reveal">
            <li><b>{{ counts.postes }}</b><span>{{ tr.tlJobs }}</span></li>
            <li><b>{{ counts.formations }}</b><span>{{ tr.tlTrainings }}</span></li>
            <li><b>{{ tr.tlYears }}</b><span>{{ tr.tlYearsLabel }}</span></li>
        </ul>

        <div class="filters reveal" role="group" aria-label="{{ tr.tlFilterAria }}">
            <button type="button" class="filter is-on" data-filter="all" aria-pressed="true">{{ tr.tlAll }}</button>
            <button type="button" class="filter" data-filter="poste" aria-pressed="false">{{ tr.tlJobsBtn }}</button>
            <button type="button" class="filter" data-filter="formation" aria-pressed="false">{{ tr.tlTrainingsBtn }}</button>
        </div>

        <ol class="timeline" data-timeline>
            <li class="tl-rail" aria-hidden="true"><i class="tl-fill"></i></li>
            {% for t in timeline %}
                <li class="tl-item reveal" data-type="{{ t.type }}">
                    <span class="tl-num f-d" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
                    <i class="tl-dot" aria-hidden="true"></i>
                    <div class="tl-when">
                        <span class="tl-period">{{ t.period }}</span>
                        <span class="tl-dur">{{ t.duration }}</span>
                    </div>
                    <div class="tl-card">
                        <div class="tl-head">
                            {% if t.logo %}<img src="{{ asset(t.logo) }}" alt="" class="tl-logo" loading="lazy">{% endif %}
                            <div>
                                <span class="tl-type">{{ t.type == 'poste' ? tr.tlJob : tr.tlTraining }}</span>
                                <h3>{{ t.title }}</h3>
                                <p class="tl-org">{{ t.org }}</p>
                            </div>
                        </div>
                        {% if t.text %}<p>{{ t.text }}</p>{% endif %}
                        {% if t.items is not empty %}
                            <ul class="tl-list">
                                {% for it in t.items %}<li>{{ it }}</li>{% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ol>
    </div>
</section>
