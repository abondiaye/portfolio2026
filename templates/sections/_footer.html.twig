<footer class="foot">
    <div class="wrap foot-in">
        <p>© {{ 'now'|date('Y') }} {{ contact.name }} · Lyon</p>
        <p>
            <a href="https://geniuspro360.com" target="_blank" rel="noopener">{{ tr.footFreelance }}</a>
            · <button type="button" class="link-btn" data-open="mentions">{{ tr.legal }}</button>
        </p>
    </div>

    <dialog id="mentions" class="modal" aria-labelledby="mentions-titre">
        <h2 id="mentions-titre">{{ tr.legal }}</h2>
        <h3>{{ tr.legalEditor }}</h3>
        <p>{{ tr.legalEditorTxt }} {{ contact.email }}</p>
        <h3>{{ tr.legalHost }}</h3>
        <p>{{ tr.legalHostTxt }}</p>
        <h3>{{ tr.legalData }}</h3>
        <p>{{ tr.legalDataTxt }}</p>
        <h3>{{ tr.legalContent }}</h3>
        <p>{{ tr.legalContentTxt }}</p>
        <form method="dialog"><button class="send">{{ tr.close }}</button></form>
    </dialog>
</footer>
