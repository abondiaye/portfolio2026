<section class="sec contact" id="contact" aria-labelledby="contact-titre">
    <div class="wrap contact-grid">
        <div>
            <p class="eyebrow reveal"><i></i>{{ tr.ctEyebrow }}</p>
            <h2 id="contact-titre" class="sec-title" data-head>{{ tr.ctTitle|raw }}</h2>
            <p class="lead reveal">{{ tr.ctLead }}</p>

            <div class="card-contact has-photo reveal">
                <figure class="cc-photo">
                    <img src="{{ asset('asset/contact-plage.jpg') }}" alt="{{ tr.ctPhotoAlt }}" width="360" height="440" loading="lazy">
                    <figcaption class="f-m"><b></b>{{ tr.ctCaption }}</figcaption>
                </figure>
                <div class="cc-info">
                <p class="cc-name">{{ contact.name }}</p>
                <p class="cc-role">{{ tr.ctRole }}</p>
                <a href="tel:{{ contact.phoneLink }}">{{ contact.phone }}</a>
                <a href="mailto:{{ contact.email }}">{{ contact.email }}</a>
                <div class="cc-actions">
                    <a class="chip-btn" href="{{ asset(contact.vcard) }}" download>{{ tr.ctSave }}</a>
                    <a class="chip-btn" href="{{ asset(contact.cv) }}" download>{{ tr.ctCv }}</a>
                    <a class="chip-btn chip-wa" href="https://wa.me/{{ contact.phoneLink|replace({'+': ''}) }}?text={{ tr.waHello|url_encode }}" target="_blank" rel="noopener"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.98L2 22l5.17-1.5A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.07.89.9-3-.2-.31a8.2 8.2 0 1 1 6.85 3.74Zm4.5-6.14c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.12-.16.25-.64.8-.79.97-.14.16-.29.18-.54.06a6.7 6.7 0 0 1-3.32-2.9c-.25-.43.25-.4.72-1.33.08-.16.04-.3-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42h-.48a.92.92 0 0 0-.66.31 2.8 2.8 0 0 0-.87 2.07 4.86 4.86 0 0 0 1.02 2.58c.12.16 1.76 2.7 4.28 3.78 1.6.69 2.22.75 3.02.63.49-.07 1.46-.6 1.67-1.18.2-.58.2-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/></svg> WhatsApp</a>
                </div>
                </div>
            </div>

            <ul class="links reveal">
                {% for l in links %}
                    <li><a href="{{ l.href }}" target="_blank" rel="noopener">{{ l.label }} <span aria-hidden="true">↗</span></a></li>
                {% endfor %}
            </ul>
        </div>

        <form class="form reveal" id="contact-form" data-endpoint="https://formsubmit.co/ajax/{{ contact.email }}" novalidate>
            <label>{{ tr.fMail }}
                <input type="email" name="email" autocomplete="email" required>
            </label>
            <label>{{ tr.fMsg }}
                <textarea name="message" rows="7" required></textarea>
            </label>
            <label class="check">
                <input type="checkbox" name="demande_cv" value="oui">
                {{ tr.fCv }}
            </label>
            {# Anti-spam : champ invisible que seuls les robots remplissent #}
            <div class="honeypot" aria-hidden="true">
                <label>{{ tr.fHoney }} <input type="text" name="_honey" tabindex="-1" autocomplete="off"></label>
            </div>
            {# un seul bouton : le message part par mail (FormSubmit) ET WhatsApp s'ouvre avec le même message #}
            <button type="submit" class="send" data-wa="{{ contact.phoneLink|replace({'+': ''}) }}" data-wa-hello="{{ tr.waHello }}">{{ tr.fSend }} <span class="send-sub">{{ tr.fSendSub }}</span></button>
            <p class="send-note">{{ tr.fNote }}</p>
            <p class="form-msg" role="status" aria-live="polite"></p>
        </form>
    </div>
</section>
